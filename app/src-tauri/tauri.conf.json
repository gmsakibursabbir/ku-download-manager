{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KuDownloader",
  "mainBinaryName": "kudownloader",
  "version": "0.2.6",
  "identifier": "digital.kuduy.kudownloader",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KuDownloader",
        "width": 1280,
        "height": 780,
        "minWidth": 900,
        "minHeight": 560,
        "decorations": false,
        "visible": false,
        "center": true,
        "dragDropEnabled": false,
        "transparent": false,
        "backgroundColor": "#161618"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' https: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "appimage",
      "rpm"
    ],
    "category": "Utility",
    "shortDescription": "Lightweight native download manager",
    "longDescription": "KuDownloader is a fast download manager powered by aria2 and yt-dlp with browser integration, queues, scheduling and torrents.",
    "copyright": "© KUDUY",
    "publisher": "KUDUY",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    },
    "license": "MIT"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhCQkU4QkJCODMxNDQ4NkMKUldSc1NCU0R1NHUraTBwT2d1b2crNFNYSkVWd2xWcHNURERPNms5VU1nR0g0V0pvYlY2eDR3L1QK",
      "endpoints": [
        "https://github.com/gmsakibursabbir/ku-download-manager/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
