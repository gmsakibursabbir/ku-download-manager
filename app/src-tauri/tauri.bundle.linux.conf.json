{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "externalBin": [
      "binaries/ku-native-host",
      "binaries/ku"
    ],
    "resources": {
      "../../extension/dist/chrome/": "extension/chrome/",
      "../../extension/dist/firefox/": "extension/firefox/",
      "../../extension/dist/packages/": "extension/"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "aria2"
        ],
        "recommends": [
          "ffmpeg"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "aria2"
        ],
        "recommends": [
          "ffmpeg"
        ]
      }
    }
  }
}
