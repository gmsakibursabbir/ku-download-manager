{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": [
      "deb",
      "rpm"
    ],
    "externalBin": [
      "binaries/ku-native-host",
      "binaries/ku"
    ],
    "resources": {
      "../../extension/dist/chrome/": "extension/chrome/",
      "../../extension/dist/firefox/": "extension/firefox/",
      "../../extension/dist/packages/": "extension/"
    },
    "linux": {
      "deb": {
        "depends": [
          "aria2",
          "ffmpeg",
          "yt-dlp"
        ]
      },
      "rpm": {
        "depends": [
          "aria2",
          "ffmpeg",
          "yt-dlp"
        ]
      }
    }
  }
}
